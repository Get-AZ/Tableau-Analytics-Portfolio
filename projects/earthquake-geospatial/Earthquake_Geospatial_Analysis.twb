            </column>
            <column caption='Place' datatype='string' name='[place]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0162478622515200]' derivation='Sum' name='[sum:Calculation_0162478622515200:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
