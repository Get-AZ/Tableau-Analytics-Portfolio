            <column caption='Country' datatype='string' name='[place - Split 5]' role='dimension' semantic-role='[Country].[Name]' type='nominal' user:SplitFieldIndex='5' user:SplitFieldOrigin='[federated.1pbaolm1ftsmh215b5gw519op2cx].[place]'>
